# Render / Production Environment Variables
# 1. Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Firebase Service Account Key (Paste the ENTIRE content of serviceAccountKey.json as one line or JSON string)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"smart-polycare-free",...}

# 3. Python Version
PYTHON_VERSION=3.11.9

# 4. Port (Render automatically provides $PORT, defaults to 10000 on Render or 5000 locally)
PORT=5000
